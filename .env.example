# ==========================================
# ASBILY CONTROLLER — ENVIRONMENT TEMPLATE
# Copy to .env for local development.
# NEVER commit real secrets to GitHub.
# ==========================================

# Server & Runtime
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=

# Controller Authentication & Security
CONTROLLER_SESSION_SECRET=
CONTROLLER_ENCRYPTION_KEY=
ASBILY_ADMIN_EMAIL=
ASBILY_ADMIN_PASSWORD=

# Asbily Platform URLs
ASBILY_ACCOUNT_URL=
ASBILY_CONTROLLER_URL=
ASBILY_MYACCOUNT_URL=

# Cloudflare Workers Gateway
CF_GATEWAY_URL=
GATEWAY_SIGNING_SECRET=
GATEWAY_ADMIN_TOKEN=

# Backend Provider: Vercel
VERCEL_BACKEND_URL=
VERCEL_API_KEY=
VERCEL_API_SECRET=
VERCEL_API_TOKEN=

# Backend Provider: Railway
RAILWAY_BACKEND_URL=
RAILWAY_API_KEY=
RAILWAY_API_SECRET=
RAILWAY_API_TOKEN=

# Backend Provider: Render
RENDER_BACKEND_URL=
RENDER_API_KEY=
RENDER_API_SECRET=
RENDER_API_TOKEN=

# Active & Default Routing
ACTIVE_PROVIDER=vercel
DEFAULT_PROVIDER=vercel

# Database & Cache
DATABASE_URL=
REDIS_URL=

# Firebase
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_MEASUREMENT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Payments (Lemon Squeezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_API_URL=
LEMONSQUEEZY_MEMBERSHIP_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=